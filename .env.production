# Valores de produção usados no build (npm run build). Todos são públicos: o Next embute as
# NEXT_PUBLIC_* no HTML e no JavaScript da página, então não há segredo aqui.

# O app de reservas (festario-web), para onde vão "Quero reservar uma festa", "Entrar" e "Criar conta"
NEXT_PUBLIC_APP_URL=https://app.festario.com.br

# Endereço público desta landing: canonical, Open Graph, sitemap.xml e robots.txt
NEXT_PUBLIC_SITE_URL=https://festario.com.br
