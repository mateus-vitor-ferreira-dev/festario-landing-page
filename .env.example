# Copie para .env.local. Todas são NEXT_PUBLIC_: o valor é embutido no build
# (mudou? rode o build de novo).

# App de reservas (festario-web). Os botões "Quero reservar uma festa",
# "Entrar" e "Criar conta" apontam para cá (/cadastro e /login).
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Endereço público desta landing: canonical, Open Graph, sitemap.xml e robots.txt.
# Padrão: https://festario.com.br
NEXT_PUBLIC_SITE_URL=

# Contato comercial do Festário (CTA "Quero o Festário no meu salão", seção de
# contato, rodapé e botão flutuante). WhatsApp com DDI e DDD; pontuação é ignorada.
# Vazio usa o padrão de src/lib/contact.ts: (35) 99746-0058.
NEXT_PUBLIC_CONTACT_WHATSAPP=

# E-mail comercial: opcional, ainda não existe. Definido, aparece como segunda opção
# de contato e vira o destino do CTA se não houver WhatsApp.
NEXT_PUBLIC_CONTACT_EMAIL=
