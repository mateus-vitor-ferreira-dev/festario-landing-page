// Publicação no Cloudflare Workers, no lugar da Vercel. A landing é um site estático
// (o "next build" com output: 'export' gera out/), sem código de servidor.
// Deploy pelo Workers Builds: "npm run build" e "npx wrangler deploy".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "festario-landing-page",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./out",
    // Endereço que não existe mostra a página 404 que o Next gera
    "not_found_handling": "404-page"
  },
  // O "wrangler deploy" liga os domínios ao worker e o Cloudflare cria o DNS e o certificado.
  // O www serve a mesma landing; o canonical das páginas aponta para festario.com.br.
  "routes": [
    { "pattern": "festario.com.br", "custom_domain": true },
    { "pattern": "www.festario.com.br", "custom_domain": true }
  ],
  // Cada branch ganha um link próprio de preview, como na Vercel
  "previews": {}
}
